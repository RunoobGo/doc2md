<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Doc2md 周任务（附录 C-2 / ADR-30）：周日本地墙钟 00:30 触发 doc2md cron 的周流程（TZ=UTC 仅设定子进程时钟口径，不改触发时刻）。
     周流程是日流程的超集（先幂等跑完日报各步骤，再追加外置加密增量打包）。
     口令：DOC2MD_BACKUP_PASSPHRASE 不要写进本 plist（NFR-20 密钥纪律）；
     推荐用 launchctl setenv DOC2MD_BACKUP_PASSPHRASE ... 或 Login Keychain 包装脚本注入。
     未配置 ops.backup_external_dir 时该步骤记为 skipped，不算失败（CH-433）。
     注：ProgramArguments / WorkingDirectory / 显式根参数（root）三处路径一律按实际部署
         前缀改写（方案示例为 /Users/you/doc2md）。CH-475（R6-OPS-1）补 WorkingDirectory
         与显式 root，钉住工作根——launchd 默认 cwd 为 /，缺此二者时相对根名 work 会被
         root_setting 解析成 /work（与日任务同因，Windows 孪生已带 WorkingDirectory）。
     注：XML 注释内不得出现连续两个连字符（XML 1.0 注释非法令牌），
         故注释里写「日/周流程」而非命令行开关；ProgramArguments 里的开关不受影响。 -->
<plist version="1.0"><dict>
  <key>Label</key><string>md.doc2md.cron.weekly</string>
  <key>ProgramArguments</key><array>
    <string>/Users/you/doc2md/env/bin/doc2md</string>
    <string>cron</string><string>--weekly</string>
    <string>--root</string><string>/Users/you/doc2md/work</string></array>
  <key>WorkingDirectory</key><string>/Users/you/doc2md</string>
  <key>StartCalendarInterval</key><dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>0</integer><key>Minute</key><integer>30</integer></dict>
  <key>EnvironmentVariables</key><dict><key>TZ</key><string>UTC</string></dict>
  <key>StandardOutPath</key><string>/Users/you/doc2md/work/logs/launchd-weekly.out</string>
  <key>StandardErrorPath</key><string>/Users/you/doc2md/work/logs/launchd-weekly.err</string>
</dict></plist>
