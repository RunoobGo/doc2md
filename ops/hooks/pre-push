#!/bin/sh
# 双保险：push 前本地跑红线。平台侧必需检查已生效（CH-468：main = merge-gate 三档），
# 但它只拦 PR 合并、不拦直推 main（CH-470），所以本钩子仍是直推路径上的唯一防线。
# 启用：git config core.hooksPath ops/hooks
# 绕过：git push --no-verify（登记在案时可用；日常不要绕）。
# 红线口径：pytest -m gate（当前 146 项；项数随轮次变化，权威清单见方案 附录 F，
# 本行只是提示，判定始终是「全绿方可推送」——与 CI merge-gate 同一断言面）。
set -e
cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] running red-line gate (pytest -m gate)..."
# 门禁历史 49–110s 视机器负载；给 300s 上限防挂死
if python3 -m pytest -m gate -q -p no:cacheprovider --tb=line >/tmp/doc2md-gate.log 2>&1; then
    echo "[pre-push] gate OK — $(grep -c '^\.' /tmp/doc2md-gate.log 2>/dev/null || echo '?') groups passed"
    exit 0
fi
echo "[pre-push] GATE FAILED — push rejected. Log: /tmp/doc2md-gate.log"
echo "[pre-push] last failures:"
grep -E "^(FAILED|ERROR)" /tmp/doc2md-gate.log | head -10 || tail -5 /tmp/doc2md-gate.log
exit 1
