# 运行期产物（work/ 为数据边界，绝不入库）
work/
env/
.venv/
# 常驻服务与探针写出的运行日志（`logs/app.jsonl`，见 events.emit / RotatingJsonlWriter）
logs/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# coverage.py 数据（收口取证 `coverage run -m pytest` 产出，不入库）
.coverage
.coverage.*
*.egg-info/
build/
dist/

# 状态库与备份（含正文，NFR-20 数据边界）
state.sqlite*
*.sqlite-wal
*.sqlite-shm
settings_override.json
*.enc
tokenizer.manifest.json
*.vocab
vocab.jsonl

# 可选大资产（CH-443：分发包不内置，由 tests/make_golden.py 现补）
tests/golden/bigfile.bin

# 本地模型资产（GGUF 不入库；ops/llm.md 的引入纪律）
vendor/models/
*.gguf

# 工具/会话本地数据
.qoder-credits/
.workbuddy/
# 运行探针与临时目录（pytest basetemp / 批量压测产物 / 全量日志）
tmp/

# 编辑器 / 系统
.DS_Store

# 本机用户提供的真实/内部语料（只做本地验证，不进入公开仓库）
tests/corpus/tests/
